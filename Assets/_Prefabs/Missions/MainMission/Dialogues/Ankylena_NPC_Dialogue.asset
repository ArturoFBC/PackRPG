  m_EditorClassIdentifier: 
  saveSpeeches:
  - text: Are you alright? You look nervous.
    childrenIDs: 01000000
    speakerID: 0
    editorPosition:
      serializedVersion: 2
      x: 0
      y: 0
      width: 250
      height: 90
  - text: I am a little bit nervous.
    childrenIDs: 02000000
    speakerID: 1
    editorPosition:
      serializedVersion: 2
      x: 299
      y: 0
      width: 250
      height: 90
  - text: Why don't you go stay with our eggs for a litte while? It always relaxes
      me.
    childrenIDs: 0300000004000000
    speakerID: 0
    editorPosition:
      serializedVersion: 2
      x: 606
      y: 1
      width: 250
      height: 90
  - text: That is a good idea, the egg chamber is alwas so quiet.
    childrenIDs: 06000000
    speakerID: 1
    editorPosition:
      serializedVersion: 2
      x: 899
      y: 0
      width: 250
      height: 90
  - text: I dont feel like it.
    childrenIDs: 05000000
    speakerID: 1
    editorPosition:
      serializedVersion: 2
      x: 897
      y: 100
      width: 250
      height: 90
  - text: As you wish.
    childrenIDs: 
    speakerID: 0
    editorPosition:
      serializedVersion: 2
      x: 1184
      y: 99
      width: 250
      height: 90
  - text: You will feel better in no time.
    childrenIDs: 
    speakerID: 0
    editorPosition:
      serializedVersion: 2
      x: 1190
      y: 0
      width: 250
      height: 90
  saveSpeechIDs: 00000000010000000200000003000000040000000500000006000000
